# Application port (uvicorn binds this port inside the container)
APP_PORT=8000
# Path to the SQLite database file
DATABASE_PATH=/data/events.db
# Lifetime in seconds of a consumer claim lease (positive integer)
LEASE_DURATION_SECONDS=30
# Consecutive nacks on a batch's first event before it is dead-lettered (positive integer)
CONSUMER_MAX_ATTEMPTS=3
# HMAC-SHA256 key signing snapshot export cursors (set a random value in production)
SNAPSHOT_CURSOR_SECRET=dev-snapshot-cursor-secret
